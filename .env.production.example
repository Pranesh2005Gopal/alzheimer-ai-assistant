# Production template only. Do not put real credentials or patient data here.
ENVIRONMENT=production
CORS_ORIGINS=https://YOUR_FIREBASE_PROJECT.web.app,https://YOUR_DOMAIN
AUTH_ENCRYPT_KEY=SET_IN_PROVIDER_SECRET_MANAGER
DATABASE_URL=postgresql+psycopg://APP_USER:SET_IN_SECRET_MANAGER@DB_HOST:5432/memorycare?sslmode=require
DATABASE_PATIENT_ID=patient-1
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:0.5b
DUCKLING_URL=http://127.0.0.1:8000
