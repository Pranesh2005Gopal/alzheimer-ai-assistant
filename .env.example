# Development defaults only. Copy to .env locally; never commit .env or a real key.
ENVIRONMENT=development
# Comma-separated browser origins. Required when ENVIRONMENT=production.
CORS_ORIGINS=http://localhost:8080
# Required when ENVIRONMENT=production. Generate a unique value and store it in
# the deployment provider's secret manager, never in this file.
AUTH_ENCRYPT_KEY=
# Use a password-authenticated, least-privilege PostgreSQL role. Do not commit .env.
DATABASE_URL=postgresql+psycopg://memorycare_app:CHANGE_ME@127.0.0.1:5432/memorycare
DATABASE_PATIENT_ID=patient-1
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
# Service endpoints are configurable for a hosted backend.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:0.5b
DUCKLING_URL=http://127.0.0.1:8000
# Comma-separated existing account emails permitted to perform one-time legacy links.
CARE_ADMIN_EMAILS=
